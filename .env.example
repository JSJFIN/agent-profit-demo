PROFIT_API_BASE_URL=https://test-x402.ailabra.org
# Separate buyer wallet only. Never use a seller key or recovery phrase.
X402_BUYER_PRIVATE_KEY=0x...
X402_EXPECTED_NETWORK=eip155:84532
X402_EXPECTED_ASSET=0x036cbd53842c5426634e7929541ec2318f3dcf7e
X402_EXPECTED_SYMBOL=USDC
X402_EXPECTED_DECIMALS=6
X402_EXPECTED_EIP712_NAME=USDC
X402_EXPECTED_EIP712_VERSION=2
X402_MAX_PAYMENT=0.25
# Maximum cumulative x402 authorization for one CLI execution.
X402_MAX_TOTAL_SPEND=0.31
# One attempt is the safest default. Failed paid requests are never retried automatically.
X402_MAX_ATTEMPTS=1
# Optional public recipient allowlist.
X402_EXPECTED_PAY_TO=0x...
LEDGER_PATH=ledger.json
REPORT_OUTPUT_PATH=artifacts/autonomous-agent-profit-report.html
LOG_LEVEL=info
