{
  "name": "@jsjfin/agent-profit",
  "version": "0.1.0",
  "description": "Typed SDK and guarded x402 CLI for Ailabra Agent Profit Ledger.",
  "type": "module",
  "bin": {
    "agent-profit": "dist/cli.js",
    "agent-profit-demo": "dist/cli.js",
    "agentprofit": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples/autonomous-business-events.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "tsx src/cli.ts",
    "view-report": "node scripts/view-report.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "package:audit": "node scripts/audit-package.mjs",
    "generate:openapi-types": "node scripts/generate-openapi-types.mjs",
    "prepublishOnly": "npm run package:audit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSJFIN/agent-profit-demo.git"
  },
  "keywords": [
    "x402",
    "mcp",
    "ai-agents",
    "agentic-commerce",
    "finops",
    "profit",
    "cash-flow",
    "profitability",
    "usdc",
    "base",
    "ed25519",
    "typescript"
  ],
  "author": "JSJFIN",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JSJFIN/agent-profit-demo/issues"
  },
  "homepage": "https://x402.ailabra.org",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.8"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
