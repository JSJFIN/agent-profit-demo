{
  "name": "agent-profit-demo",
  "version": "1.0.1",
  "description": "Independent black-box x402 client and HTML profit report for autonomous agents",
  "type": "module",
  "bin": {
    "agent-profit-demo": "dist/cli.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "tsx src/cli.ts",
    "view-report": "node scripts/view-report.mjs",
    "secret-scan": "node scripts/secret-scan.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JSJFIN/agent-profit-demo.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JSJFIN/agent-profit-demo/issues"
  },
  "homepage": "https://github.com/JSJFIN/agent-profit-demo#readme",
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "@x402/fetch": "^2.20.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
